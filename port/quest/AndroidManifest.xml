<?xml version="1.0" encoding="utf-8"?>
<!-- BLACK VR for Meta Quest 3 / 3S: NativeActivity, no Java code. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kenny.blackvr"
    android:versionCode="1"
    android:versionName="0.1.0"
    android:installLocation="auto">

  <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="32" />

  <!-- Quest: head tracking, 6DoF controllers, Vulkan 1.1. -->
  <uses-feature android:glEsVersion="0x00030001" android:required="true" />
  <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="true" />
  <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
  <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />
  <uses-feature android:name="oculus.software.handtracking" android:required="false" />

  <!-- OpenXR runtime broker (Khronos loader) -->
  <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
  <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
  <!-- Game files: the app's own external files dir needs no permission. These let
       the app read /sdcard/BLACK instead (Android 10: legacy storage; 11+: the user
       grants "All files access" in Settings when asked). -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

  <queries>
    <!-- to talk to the OpenXR runtime broker -->
    <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
    <!-- so client-side code of runtime/layers can talk to their service sides -->
    <intent>
      <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
    </intent>
    <intent>
      <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
    </intent>
  </queries>

  <!-- allowNativeHeapPointerTagging="false": with targetSdk >= 30 on arm64, malloc returns pointers whose top byte is
       a tag (0xB4..) and free() aborts if it was lost. The recompiled runtime was written against x86, where no such
       tag exists; this keeps that one device-only failure mode out of the first runs (port/notes/device-preflight.md;
       the PREFLIGHT begin line shows the heap pointer). -->
  <application
      android:label="@string/app_name"
      android:hasCode="false"
      android:allowBackup="false"
      android:requestLegacyExternalStorage="true"
      android:allowNativeHeapPointerTagging="false"
      android:extractNativeLibs="false">

    <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s" />
    <meta-data android:name="com.oculus.intent.category.VR" android:value="vr_only" />
    <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
    <meta-data android:name="com.oculus.handtracking.frequency" android:value="HIGH" />

    <activity
        android:name="android.app.NativeActivity"
        android:exported="true"
        android:launchMode="singleTask"
        android:resizeableActivity="false"
        android:screenOrientation="landscape"
        android:excludeFromRecents="false"
        android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
      <meta-data android:name="android.app.lib_name" android:value="blackvr" />
      <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="com.oculus.intent.category.VR" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
